# ---- required ----
DATABASE_URL=postgres://user:pass@host:5432/dbname
# Signs login sessions. Required (16+ chars) when NODE_ENV=production; the server refuses to start without it.
JWT_SECRET=change-me-to-a-long-random-string

# ---- first owner (created at boot if no account with that email exists; never overwrites a password) ----
BOOTSTRAP_OWNER_EMAIL=you@example.com
BOOTSTRAP_OWNER_PASSWORD=choose-a-strong-password
# BOOTSTRAP_OWNER_NAME=Your Name

# ---- password reset e-mail (optional; without SMTP the reset link is only printed in the server log) ----
# Public URL of this app, used to build the reset link
FRONTEND_URL=https://roster.impactdigital.network
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Roster <no-reply@example.com>

# ---- optional hardening ----
# CORS_ORIGINS=https://roster.impactdigital.network
# WHATSAPP_APP_SECRET=   # Meta app secret: when set, the WhatsApp webhook POST must carry a valid X-Hub-Signature-256
# LOGIN_MAX_ATTEMPTS=5   # failed logins per IP+email per 15 min before HTTP 429
PORT=10000

# Shared key Harbor sends in X-Admin-Key to read GET /api/admin-summary (Harbor -> Produtos).
# ADMIN_SUMMARY_KEY=
