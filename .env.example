# ---- required ----
DATABASE_URL=postgres://user:pass@host:5432/dbname
# Signs login sessions. Required (16+ chars) when NODE_ENV=production; the server refuses to start without it.
JWT_SECRET=change-me-to-a-long-random-string

# ---- first owner (created at boot if no account with that email exists; never overwrites a password) ----
BOOTSTRAP_OWNER_EMAIL=you@example.com
BOOTSTRAP_OWNER_PASSWORD=choose-a-strong-password
# BOOTSTRAP_OWNER_NAME=Your Name

# ---- password reset e-mail (optional; without SMTP the reset link is only printed in the server log) ----
# Public URL of this app, used to build the reset link
FRONTEND_URL=https://roster.impactdigital.network
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Roster <no-reply@example.com>
# Also used for: e-mails to candidates from the Messages window and invoices sent to clients (the agency's name is the sender name,
# replies go to the agency's profile e-mail).

# ---- client portal, invoices, SMS (Essential plan and up) ----
# Public address of this app. Used for the portal link in invoice e-mails and to check the Twilio reply-webhook signature.
# Unset: the address of the request is used (fine behind Coolify's proxy).
# PUBLIC_URL=https://roster.impactdigital.network
# Key that encrypts the agency's Twilio Auth Token in the database. Unset: derived from JWT_SECRET (changing it makes a saved token unreadable: reconnect).
# ENCRYPTION_KEY=
# SMS uses the agency's OWN Twilio account (Settings > SMS). In Twilio set the reply webhook to <PUBLIC_URL>/api/integrations/sms/webhook.

# ---- optional hardening ----
# CORS_ORIGINS=https://roster.impactdigital.network
# WHATSAPP_APP_SECRET=   # Meta app secret: when set, the WhatsApp webhook POST must carry a valid X-Hub-Signature-256
# LOGIN_MAX_ATTEMPTS=5   # failed logins per IP+email per 15 min before HTTP 429
PORT=10000

# Shared key Harbor sends in X-Admin-Key to read GET /api/admin-summary (Harbor -> Produtos).
# ADMIN_SUMMARY_KEY=

# "Import from photo" (AI reads a photo/print and fills the record; the person reviews before saving).
# Same ANTHROPIC_API_KEY as the rest of the platform. Without it the button says "not turned on yet".
# Monthly limit: Professional 100 · Complete 500 (o plano vem de LICENSED_PLAN ou da assinatura no Stripe; sem os dois, instalação sem limite = Complete) (+100 migration pack in the first 30 days; 3-day trial: 3 reads).
# PHOTO_IMPORT_MODEL=claude-sonnet-5-5
# Extra use: after the limit the owner approves a monthly cap; each extra read becomes a line on the next Stripe invoice.
PHOTO_EXTRA_CENTS=10
PHOTO_EXTRA_CAPS_CENTS=1000,2500,5000,10000
BILLING_STRIPE_CUSTOMER_ID=
BILLING_STRIPE_SUBSCRIPTION_ID=

# ---- Complete plan tools ----
# AI writing (candidate profile, job post) uses the same ANTHROPIC_API_KEY as "import from photo". Cap per installation per month:
# AI_MONTHLY_LIMIT=300
# ROSTER_AI_MODEL=claude-sonnet-5-5
# E-signature through the agency's self-hosted Documenso (the agency uploads its own PDF; the signed copy is stored in the database):
# DOCUMENSO_URL=https://sign.example.com
# DOCUMENSO_API_TOKEN=
# DOCUMENSO_TIMEZONE=America/New_York
# API keys and webhooks are created by the owner in Settings > API & webhooks. Webhook addresses must be public https (private networks are refused).

# ---- Careers page, plan seal ----
# Name shown on the public careers page (#/careers, Essential plan and up).
COMPANY_NAME=
# Platform owners (comma-separated e-mails): they get "View as plan" in the menu to see Roster as the Basic / Essential / Complete
# customer would (looking only: billing, AI, e-mail/SMS and other things that spend or send are blocked while previewing).
# OWNER_EMAILS=
# Resume reading by AI (Essential and up) uses the same ANTHROPIC_API_KEY; without it, or on the Basic plan, the free simple reading is used.

# ---- Plans and billing (Stripe account of Impact Digital: ONE account for every product) ----
# Plans: Basic US$79 · Essential US$149 · Complete US$269 per month (yearly = 12 months minus 10%).
# Without STRIPE_SECRET_KEY nothing is locked (own instance, demo, manual install). LICENSED_PLAN (basico|essencial|completo) is set by
# Impact Digital's provisioning robot on customer installs and always wins.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=            # webhook endpoint: <app>/api/billing/webhook (checkout.session.completed, customer.subscription.updated/deleted)
# STRIPE_PRICE_BASICO=price_...     # monthly prices (US$79 / 149 / 269)
# STRIPE_PRICE_ESSENCIAL=price_...
# STRIPE_PRICE_COMPLETO=price_...
# STRIPE_PRICE_BASICO_ANUAL=price_...    # yearly prices (optional; US$853.20 / 1,609.20 / 2,905.20). Without them "Yearly" shows "coming soon"
# STRIPE_PRICE_ESSENCIAL_ANUAL=price_...
# STRIPE_PRICE_COMPLETO_ANUAL=price_...
# STRIPE_PAYMENT_LINK_<PLAN>[_ANUAL]=    # optional ready-made checkout links
# Every checkout is tagged metadata[product]=roster; the webhook ignores events of other products. An event without the tag
# only counts when the price bought is one of the Roster prices above.
